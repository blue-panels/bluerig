EAPI=8

LUA_COMPAT=( lua5-4 )

inherit lua-single meson optfeature

DESCRIPTION="Terminal IDE, a continuation of cooledit"
HOMEPAGE="https://github.com/blue-panels/bluerig"
SRC_URI="https://github.com/blue-panels/bluerig/releases/download/bluerig-${PV}/bluerig-${PV}.tar.gz"

LICENSE="GPL-3+ LGPL-2.1+ LGPL-3+ BSD MIT"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
IUSE="+gpm +lua +slang test X"
REQUIRED_USE="lua? ( ${LUA_REQUIRED_USE} )"
RESTRICT="!test? ( test )"

COMMON_DEPEND="
	dev-libs/glib:2
	dev-libs/json-glib
	slang? ( sys-libs/slang )
	!slang? ( sys-libs/ncurses:0= )
	gpm? ( sys-libs/gpm )
	lua? ( ${LUA_DEPS} )
	X? ( x11-libs/libX11 )
"
RDEPEND="${COMMON_DEPEND}"
DEPEND="
	${COMMON_DEPEND}
	test? ( dev-libs/check )
"
BDEPEND="
	sys-devel/gettext
	virtual/pkgconfig
"

DOCS=( CHANGELOG.md README.md )

pkg_setup() {
	use lua && lua-single_pkg_setup
}

src_configure() {
	local emesonargs=(
		-Dscreen="$(usex slang slang ncurses)"
		-Dplugins_dir="${EPREFIX}/usr/$(get_libdir)/bluerig/plugins"
		-Druntime_plugins_dir="${EPREFIX}/usr/$(get_libdir)/bluerig/runtime-plugins"
		$(meson_feature gpm)
		$(meson_feature lua)
		$(meson_feature test tests)
		$(meson_feature X x11)
		-Dnls=enabled
	)
	meson_src_configure
}

pkg_postinst() {
	optfeature "spell checking" app-text/aspell app-text/hunspell
	optfeature "the tag index the editor reads" dev-util/ctags
}
