# The syntax files are not UTF-8 on purpose. Each of these has one line that
# lists the bytes from 0x20 to 0xFF as a character class, which is how the
# editor highlights any printable character inside a literal. The engine
# matches bytes and not characters: src/syntax/syntax.c fills a set of 256
# entries, one per byte. Recoded to UTF-8 the class would cover 0xC2, 0xC3 and
# 0x80 to 0xBF instead, so it would lose 0xC4 to 0xFF, and Cyrillic, Greek and
# everything else outside Latin-1 would stop matching.
bluerig: national-encoding [usr/share/bluerig/syntax/*.syntax]

# The help window reads the files in help/ at run time: they are data of the
# program, not documentation for /usr/share/doc. The two README.txt describe
# the format of the skin and syntax files beside them, for whoever copies one
# of those to edit it.
bluerig: package-contains-documentation-outside-usr-share-doc [usr/share/bluerig/help/*]
bluerig: package-contains-documentation-outside-usr-share-doc [usr/share/bluerig/skins/README.txt]
bluerig: package-contains-documentation-outside-usr-share-doc [usr/share/bluerig/syntax/README.txt]
